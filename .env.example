# Copy to `.env` and `.env.local`. Never commit those files.
# Server holds no user secrets — only its own deployer key and vendor API keys.

# --- runtime ---
PORT=8787
NODE_ENV=development

# --- Monad ---
MONAD_RPC_URL=
MONAD_CHAIN_ID=
# Foundry deploy key (contracts/). Never commit.
PRIVATE_KEY=
DEMO_AGENT_DEPLOYER_KEY=
ETHERSCAN_API_KEY=

# --- deployed addresses (filled after Phase 2) ---
MANDATE_REGISTRY=
MANDATE_EXECUTOR=
PASSKEY_ACCOUNT_FACTORY=
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8004_REPUTATION_ADAPTER=
RISK_BREAKER=
PRIVATE_SUBMITTER=

# --- Vite / WebAuthn (build-time; rpId must match the deployed hostname) ---
VITE_RP_ID=localhost
VITE_MONAD_RPC_URL=
VITE_MONAD_CHAIN_ID=
VITE_MANDATE_REGISTRY=
VITE_MANDATE_EXECUTOR=
VITE_ERC8004_IDENTITY_REGISTRY=
VITE_ERC8004_REPUTATION_ADAPTER=
VITE_ENVIO_GRAPHQL_URL=

# --- Envio ---
ENVIO_GRAPHQL_URL=
ENVIO_API_TOKEN=

# --- Privy (PR-2) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=

# --- Chainlink CRE (PR-3) ---
CRE_WORKFLOW_OWNER_KEY=
LLM_API_KEY=
KURU_API_URL=
PERPL_API_URL=

# --- Mera PRF (PR-4) ---
MERA_APP_ID=
POLICY_BLOB_STORE_URL=

