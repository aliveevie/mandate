# Copy to .env (gitignored). Never commit real values.
# Workflow owner / simulation broadcaster. Funded Monad testnet key (hex, no 0x prefix required).
CRE_ETH_PRIVATE_KEY=
# Target profile: staging-settings (mock forwarder, simulation) or production-settings.
CRE_TARGET=staging-settings
# Anthropic API key for the structured risk note (secret id LLM_API_KEY, see secrets.yaml). Optional:
# without it the workflow still attests and records "llm: unavailable" in the evidence.
LLM_API_KEY_VALUE=
