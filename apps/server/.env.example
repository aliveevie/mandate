PORT=8787
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Pays gas for the demo (account deploys, grants, revokes, agent funding, ERC-8004 registration). Never commit.
DEMO_AGENT_DEPLOYER_KEY=
# Optional overrides; defaults come from the SDK's Monad testnet deployment
MANDATE_REGISTRY=
MANDATE_EXECUTOR=
RISK_BREAKER=
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_ADAPTER=
DEMO_ASSET=
DEMO_VENUE=
# Optional hosted Envio GraphQL endpoint
ENVIO_GRAPHQL_URL=
# Production only: directory with the built Vite bundle
PUBLIC_DIR=./public

# Privy (optional). When all four are set, agent keys are Privy server wallets, mandates are mirrored as wallet
# policies, and users can sign in with Privy and delegate a scoped session signer instead of using a passkey.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Base64 PKCS8 P-256 private key of the authorization key (dashboard > Authorization keys, or generateP256KeyPair)
PRIVY_AUTHORIZATION_KEY=
# The key quorum id registered for that key; it owns agent wallets and policies and is the session signer id
PRIVY_KEY_QUORUM_ID=
