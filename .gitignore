# committed CRE simulation runs (override the *.log rule above)
!cre/simulation.log
!cre/simulation-broadcast.log

# local run logs (never committed)
.logs/

# server-side blob store + one-off secret drops
apps/server/data/
apps/server/.privy-authorization-key.env
