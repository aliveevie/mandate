*.pem
*.p12
*.pfx
*.key
!*.sol
id_rsa
id_ed25519
*.secret
secrets.json
credentials.json
auth.json
service-account*.json
.privy/
.mera/

# --- node ---
node_modules/
dist/
build/
.turbo/
.cache/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log

